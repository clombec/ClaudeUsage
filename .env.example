# Copy this file to .env and fill in the values. NEVER commit .env.

# Organization UUID (visible in the usage URL: /api/organizations/<ORG_ID>/usage)
CLAUDE_ORG_ID=00000000-0000-0000-0000-000000000000

# Full value of the "cookie" header copied from your browser DevTools
# (Network tab > request to /usage > Request Headers > cookie).
# At minimum, sessionKey / sessionKeyV3 are required.
CLAUDE_COOKIES=sessionKeyV3=sk-ant-...; sessionKey=...

# Polling interval in seconds when running in loop mode (default: 3600 = 1 hour)
POLL_INTERVAL_SECONDS=3600

# Discord webhook for failure alerts (optional; leave empty to disable)
# Discord: channel settings > Integrations > Webhooks > New webhook > Copy URL
DISCORD_WEBHOOK_URL=

# Django dashboard
DJANGO_SECRET_KEY=change-me
DEBUG=True

# Hosts allowed to reach the dashboard (comma-separated). Add the PC's Tailscale IP
# when the dashboard is served by HomeRun on ${TAILSCALE_IP}:8060.
ALLOWED_HOSTS=localhost,127.0.0.1,100.x.y.z
